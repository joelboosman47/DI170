# Runtime environment: "development" or "production"
# Affects cookie security and error detail in responses
NODE_ENV=development

# Port the API server listens on
PORT=3000

# Path to the SQLite database file (relative to the server package)
SQLITE_PATH=./sqlite.db

# Secret used to sign JWT auth tokens — use a long random string
# Generate one with: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-here

# How long JWTs stay valid (e.g. 1d, 7d, 12h)
JWT_EXPIRES_IN=1d
